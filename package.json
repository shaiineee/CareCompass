{
  "name": "carecompass",
  "version": "2.2.0",
  "private": true,
  "description": "CareCompass care-plan companion: Express backend and accessible frontend",
  "type": "commonjs",
  "main": "app.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "check": "node --check app.js && node --check public/app.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-check.js",
    "test:documents": "node scripts/document-check.js",
    "db:migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.1",
    "pdf-parse": "1.1.1",
    "pg": "^8.23.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
